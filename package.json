{
  "name": "@fabric/http",
  "version": "0.1.0-RC1",
  "description": "tools for serving the legacy web with Fabric",
  "main": "types/web.js",
  "module": "module.js",
  "type": "commonjs",
  "bin": {
    "fabric-http": "./scripts/node.js"
  },
  "scripts": {
    "build": "npm test && npm run build:scripts && npm run build:docs",
    "build:app": "npm run build:scripts",
    "build:docs": "jsdoc -c jsdoc.json types/**.js settings/deprecations.js README.md -d docs",
    "build:coverage": "npm run coverage && c8 report --reporter=html",
    "build:fast": "npm run build:scripts",
    "build:scripts": "node scripts/build.js",
    "build:semantic": "node scripts/build-semantic.js",
    "make:fonts": "node scripts/download-fonts.js",
    "build:views": "jade --pretty -o assets/ views/site.jade",
    "ci": "npm test && npm run build:scripts",
    "compile": "npm run build:scripts",
    "coverage": "c8 npm test",
    "deploy": "npm run build && fabric-http",
    "docs": "npm run build:docs && fabric-http docs",
    "make:api": "jsdoc2md --configure jsdoc.json --files types/*.js settings/deprecations.js README.md > API.md.tmp && mv API.md.tmp API.md",
    "reports": "npm run report:install && npm run build:coverage && npm run report:todo",
    "report:coverage": "npm run build:coverage && c8 report --reporter=text-lcov > reports/coverage.lcov",
    "report:install": "rm -rf node_modules && mkdir -p reports && rm -f package-lock.json && echo \"$ npm i --allow-git=all\" > reports/install.log && npm i --allow-git=all >> reports/install.log 2>&1",
    "report:todo": "grep --exclude-dir=.git --exclude-dir=backups --exclude-dir=_book --exclude-dir=assets --exclude-dir=node_modules --exclude-dir=reports --exclude-dir=coverage --exclude-dir=docs -rEI \"TODO|FIXME\" . > reports/TODO.txt",
    "review:coverage": "npm run build:coverage && fabric-http reports/coverage",
    "sample:hub": "node scripts/sample-hub-http-server.js",
    "start": "npm run compile && node scripts/node.js",
    "static": "npm run build:scripts && fabric-http assets",
    "test": "mocha tests",
    "test:playnet-publish": "mocha tests/playnet.federationInvite.publish.integration.js --exit",
    "test:standards": "mocha tests/standards.http.js --exit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FabricLabs/fabric-http.git"
  },
  "keywords": [
    "http",
    "web",
    "fabric",
    "bitcoin",
    "blockchain"
  ],
  "author": "Fabric Labs",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/FabricLabs/fabric-http/issues"
  },
  "homepage": "https://github.com/FabricLabs/fabric-http#readme",
  "engines": {
    "node": "24.15.0"
  },
  "exports": {
    ".": "./types/web.js",
    "./module.js": "./module.js",
    "./types/*": "./types/*.js",
    "./constants": "./constants.js",
    "./middlewares/auth": "./middlewares/auth.js",
    "./middlewares/payments": "./middlewares/payments.js",
    "./functions/fabricDocumentPayment402": "./functions/fabricDocumentPayment402.js",
    "./functions/federationContractInvite": "./functions/federationContractInvite.js",
    "./functions/messageBodyJsonBridge": "./functions/messageBodyJsonBridge.js",
    "./functions/sendPaymentRequired402Response": "./functions/sendPaymentRequired402Response.js",
    "./functions/fabricWebRtcInterop": "./functions/fabricWebRtcInterop.js",
    "./functions/fabricMessageTransport": "./functions/fabricMessageTransport.js",
    "./functions/fabricJsonRpcTransport": "./functions/fabricJsonRpcTransport.js",
    "./functions/applicationResourceContract": "./functions/applicationResourceContract.js",
    "./functions/fabricHubAllowlist": "./functions/fabricHubAllowlist.js",
    "./functions/httpSharedMode": "./functions/httpSharedMode.js",
    "./functions/fabricSiteLoginVerify": "./functions/fabricSiteLoginVerify.js",
    "./functions/fabricIdentitySchnorr": "./functions/fabricIdentitySchnorr.js",
    "./functions/identityCrossSign": "./functions/identityCrossSign.js",
    "./functions/identityCrossSignVerify": "./functions/identityCrossSignVerify.js",
    "./functions/fabricDesktopLoginVerify": "./functions/fabricDesktopLoginVerify.js",
    "./functions/fabricSiteLogin": "./functions/fabricSiteLogin.js",
    "./functions/fabricSiteLoginHttp": "./functions/fabricSiteLoginHttp.js",
    "./functions/fabricDeviceLinkMessages": "./functions/fabricDeviceLinkMessages.js",
    "./functions/fabricDeviceLinkClient": "./functions/fabricDeviceLinkClient.js",
    "./functions/fabricDeviceLinkHttp": "./functions/fabricDeviceLinkHttp.js",
    "./functions/fabricDeviceLinkProtocol": "./functions/fabricDeviceLinkProtocol.js",
    "./functions/fabricProtocolLogin": "./functions/fabricProtocolLogin.js",
    "./functions/oracleAttestation": "./functions/oracleAttestation.js",
    "./functions/fabricPeerHost": "./functions/fabricPeerHost.js",
    "./functions/fabricPubkey": "./functions/fabricPubkey.js",
    "./functions/fabricChatNormalize": "./functions/fabricChatNormalize.js",
    "./functions/fabricPeeringHttp": "./functions/fabricPeeringHttp.js"
  },
  "contributors": [
    "Eric Martindale",
    "Victor Wu"
  ],
  "dependencies": {
    "@fabric/core": "github:FabricLabs/fabric#feature/rsi",
    "assert-browserify": "=2.0.0",
    "babel-loader": "=8.2.5",
    "body-parser": "=1.20.6",
    "buffer": "=6.0.3",
    "compression": "=1.8.1",
    "content-type": "2.0.0",
    "cross-fetch": "=4.1.0",
    "crypto-browserify": "=3.12.1",
    "d3": "=7.9.0",
    "d3-graphviz": "=5.6.0",
    "express": "=4.22.2",
    "express-bearer-token": "=3.0.0",
    "express-flash": "=0.0.2",
    "express-session": "=1.19.0",
    "fast-json-patch": "=3.1.1",
    "isomorphic-ws": "=4.0.1",
    "jquery": "=3.7.1",
    "js-beautify": "=1.15.4",
    "jsdom": "=29.0.1",
    "json-pointer": "=0.6.2",
    "lodash.merge": "=4.6.2",
    "node-util": "=0.0.1",
    "page": "=1.3.7",
    "path-browserify": "=1.0.1",
    "path-to-regexp": "=6.3.0",
    "pluralize": "=7.0.0",
    "puppeteer": "=24.37.5",
    "querystring-es3": "=0.2.1",
    "stoppable": "=1.1.0",
    "stream-browserify": "=3.0.0",
    "url": "=0.11.4",
    "webpack": "=5.109.2",
    "ws": "=8.21.2"
  },
  "devDependencies": {
    "@babel/preset-env": "=7.26.7",
    "@webcomponents/webcomponentsjs": "=2.8.0",
    "ajv": "=8.20.0",
    "better-console": "npm:@fomantic/better-console@^1.0.2",
    "c8": "=11.0.0",
    "eslint": "=9.30.1",
    "fomantic-ui": "=2.9.4",
    "gulp": "=5.0.0",
    "gulp-concat-css": "npm:@fomantic/gulp-concat-css@^3.3.0",
    "gulp-concat-filenames": "npm:@fomantic/gulp-concat-filenames@^1.2.1",
    "gulp-dedupe": "npm:@fomantic/gulp-dedupe@^0.0.3",
    "gulp-git": "npm:@fomantic/gulp-git@^2.11.1",
    "gulp-header": "npm:@fomantic/gulp-header@^2.1.1",
    "gulp-plumber": "npm:@fomantic/gulp-plumber@^1.2.2",
    "jsdoc": "=4.0.4",
    "jsdoc-to-markdown": "=9.1.3",
    "marked": "=15.0.12",
    "mocha": "=11.8.0",
    "neostandard": "=0.12.1",
    "typescript": "=5.7.3"
  },
  "overrides": {
    "diff": "=8.0.4",
    "elliptic": "npm:@soatok/elliptic-to-noble@9999.0.0",
    "serialize-javascript": "=7.0.5",
    "yauzl": "=3.2.1",
    "qs": "=6.15.3",
    "body-parser": "=1.20.6",
    "ws": "=8.21.2",
    "@octokit/request": "=8.4.1",
    "@octokit/request-error": "=5.1.1",
    "@octokit/plugin-paginate-rest": "=9.2.2",
    "jayson": {
      "uuid": "14.0.0"
    },
    "@actions/http-client": {
      "undici": "6.28.0"
    },
    "@adobe/css-tools": "4.4.4"
  },
  "browser": {
    "ws": false
  },
  "c8": {
    "report-dir": "./reports/coverage",
    "temp-dir": "./reports/c8",
    "exclude": [
      "docs",
      "tests"
    ]
  },
  "semistandard": {
    "ignore": [
      "docs",
      "tests"
    ]
  }
}
