/*******************************
     Fabric Site Variables
*******************************/

/* Loaded after themes/default/globals/site.variables (theme.config @site: "fabric"). */

/* -------------------
       Fonts
-------------------- */

@fontName: "Arvo";
@unicodeRangeArvo: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;

/* Local woff2 only; never request Google Fonts. */
@importGoogleFonts: false;
@importFonts: true;
@fonts: {
    @regular: {
        font-family: @fontName;
        src: url("@{fontPath}/arvo-normal-400.woff2") format("woff2");
        font-style: normal;
        font-weight: 400;
        font-display: @fontDisplay;
        unicode-range: @unicodeRangeArvo;
    };
    @bold: {
        font-family: @fontName;
        src: url("@{fontPath}/arvo-normal-700.woff2") format("woff2");
        font-style: normal;
        font-weight: 700;
        font-display: @fontDisplay;
        unicode-range: @unicodeRangeArvo;
    };
    @italic: {
        font-family: @fontName;
        src: url("@{fontPath}/arvo-italic-400.woff2") format("woff2");
        font-style: italic;
        font-weight: 400;
        font-display: @fontDisplay;
        unicode-range: @unicodeRangeArvo;
    };
    @boldItalic: {
        font-family: @fontName;
        src: url("@{fontPath}/arvo-italic-700.woff2") format("woff2");
        font-style: italic;
        font-weight: 700;
        font-display: @fontDisplay;
        unicode-range: @unicodeRangeArvo;
    };
};

/* -------------------
      Colors
-------------------- */

@primaryColor: #336699;
@pageBackground: #3a3a3a;

/* -------------------
       Paths
-------------------- */

/* Icon fonts and Arvo ship from themes/fabric/assets (consumers sync only that folder). */
@fontPath: "../../themes/fabric/assets/fonts";
