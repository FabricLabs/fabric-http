<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title><?js= title ?> &middot; Docs</title>
    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <meta name="theme-color" content="#4C1D95">
    <script src="scripts/prettify/prettify.js"> </script>
    <script src="scripts/prettify/lang-css.js"> </script>
    <!--[if lt IE 9]>
      <script src="//html5shiv.googlecode.com/svn/trunk/html5.js"></script>
    <![endif]-->
    <link type="text/css" rel="stylesheet" href="styles/prettify-tomorrow.css">
    <link type="text/css" rel="stylesheet" href="styles/jsdoc-default.css">
  </head>
  <body>
    <div id="main">
      <h1 class="page-title"><?js= title ?></h1>
      <?js
        var editFile = null;
        if (typeof docs !== 'undefined' && docs && docs.length) {
          for (var editIndex = 0; editIndex < docs.length; editIndex++) {
            var editDoc = docs[editIndex];
            if (editDoc && editDoc.meta && editDoc.meta.shortpath && editDoc.kind !== 'source') {
              editFile = editDoc.meta.shortpath;
              break;
            }
          }
        }
        if (!editFile && typeof title === 'string' && title.indexOf('Source: ') === 0) {
          editFile = title.slice('Source: '.length);
        }
        var editHref = null;
        if (editFile && env && env.conf && env.conf.source) {
          var editRoot = String(env.conf.source).replace(/\/+$/, '').replace(/\.git$/, '')
          var editBranch = env.conf.branch || 'master';
          editHref = editRoot + '/edit/' + editBranch + '/' + String(editFile).replace(/\\/g, '/').replace(/^\//, '');
        }
      ?>
      <?js if (editHref) { ?><p><a href="<?js= editHref ?>">Edit this page</a></p><?js } ?>

      <?js= content ?>
    </div>
    <nav><?js= this.nav ?></nav>
    <br class="clear" />
    <footer>
        <a href="<?js= env.conf.source ?>">git://</a><?js if (env.conf.chat) { ?> &middot; <a href="<?js= env.conf.chat ?>">Community</a><?js } ?>
    </footer>
    <script> prettyPrint(); </script>
    <script src="scripts/linenumber.js"></script>
  </body>
</html>
